@model IEnumerable<CategoryResponse>

@{
    ViewData["Title"] = "Categories";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/js/plugins/datatables-bs5/css/dataTables.bootstrap5.min.css">
    
}

<div class="container card shadow-sm p-3">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mt-4">
        <h3>Categories</h3>
        <a href="javascript:;" onclick="showModalAdd()" class="btn btn-primary d-inline-flex align-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle me-2" viewBox="0 0 16 16" style="vertical-align: middle;">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
            </svg>
            Add
        </a>
    </div>
    <hr />
    <table class="table table-bordered table-hover table-vcenter js-dataTable-full">
        <thead>
            <tr>
                <th style="width:50px">#</th>
                <th>Name</th>
                <th>Status</th>
                <th>Created On</th>
                <th>Last Updated On</th>

                <th class="text-center" style="width:180px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr data-category-id="@category.Id">
                    <td class="text-center">@category.Id</td>
                    <td>@category.Name</td>
                    <td class="category-status">
                        @if (category.IsDeleted)
                        {
                            <span class="fs-xs fw-semibold d-inline-block py-1 px-3 rounded-pill bg-danger-light text-danger">Deleted</span>
                        }
                        else
                        {
                            <span class="fs-xs fw-semibold d-inline-block py-1 px-3 rounded-pill bg-success-light text-success">Available</span>
                        }
                    </td>
                    <td>@category.CreatedOn</td>
                    <td class="category-updated">@category.UpdatedOn</td>
                    <td class="text-center">
                        <div class="btn-group">
                            <a href="javascript:;" onclick="showModalEdit(@category.Id)" class="btn btn-sm btn-alt-secondary js-bs-tooltip-enabled" data-bs-toggle="tooltip" aria-label="Edit" data-bs-original-title="Edit">
                                <i class="fa fa-fw fa-pencil-alt"></i>
                            </a>

                            <a href="javascript:;" onclick="toggleStatus(@category.Id)" class="btn btn-sm btn-alt-secondary js-bs-tooltip-enabled" data-bs-toggle="tooltip" aria-label="Delete" data-bs-original-title="Delete">
                                <i class="fa fa-fw fa-times"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@Html.AntiForgeryToken()
@section Scripts {
    <!-- Page JS Plugins -->
    <partial name="_ValidationScriptsPartialAjax" />
    <script src="~/assets/js/plugins/datatables/dataTables.min.js"></script>
    <script src="~/assets/js/plugins/datatables-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/assets/js/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/js/plugins/datatables-responsive-bs5/js/responsive.bootstrap5.min.js"></script>
    <script src="~/assets/js/plugins/datatables-buttons/dataTables.buttons.min.js"></script>
    <script src="~/assets/js/plugins/datatables-buttons-bs5/js/buttons.bootstrap5.min.js"></script>
    <!-- Page JS Code -->
    <script src="~/assets/js/pages/be_tables_datatables.min.js"></script>
    <script>
        //Toggle category status (soft delete/restore)
        function toggleStatus(categoryId) {
        var row = document.querySelector('tr[data-category-id="' + categoryId + '"]');
        var statusElement = row ? row.querySelector('.category-status') : null;
        var updatedElement = row ? row.querySelector('.category-updated') : null;
        Swal.fire({
        title: "Are you sure you want to change the status?",
        showDenyButton: true,
        showCancelButton: false,
        confirmButtonText: "Yes",
        denyButtonText: "No",
        confirmButtonColor: "#dc3545", // ?? red (delete)
        denyButtonColor: "#6c757d",    // ? gray

        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: '/Categories/ToggleStatus',
        type: 'POST',
        data: { id: categoryId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
        success: function (response) {
        if (statusElement && statusElement.children[0].classList.contains('bg-danger-light')) {
        statusElement.children[0].textContent = 'Available';
        statusElement.children[0].classList.remove('bg-danger-light', 'text-danger');
        statusElement.children[0].classList.add('bg-success-light', 'text-success');
        } else if (statusElement) {
        statusElement.children[0].textContent = 'Deleted';
        statusElement.children[0].classList.remove('bg-success-light', 'text-success');
        statusElement.children[0].classList.add('bg-danger-light', 'text-danger');
        }

        if (updatedElement) {
            updatedElement.textContent = new Date().toLocaleString();
        }
        
        Swal.fire("Done!", "", "success");
        One.helpers('jq-notify', {type: 'success', icon: 'fa fa-check me-1', message: 'Category status updated!'});
        },
        error: function (err) {
        Swal.fire("Error!", "An error occurred while toggling the status.", "error");
        }});
        }
        else if (result.isDenied) {
        Swal.fire("Cancelled", "", "info");
        }
        });
        }
        // End of toggleStatus function

        var modal = document.querySelector('#Modal');
        var bootstrapModal = new bootstrap.Modal(modal);
        var currentMode = null; // Track if we're in 'add' or 'edit' mode
        var currentCategoryId = null; // Track the category ID for edit mode

        function showModalAdd() {
            currentMode = 'add';
            currentCategoryId = null;
            modal.querySelector('.modal-title').textContent = 'Add Category';
            $.ajax({
                url: '/Categories/Add',
                type: 'GET',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    modal.querySelector('.modal-body').innerHTML = response;
                    // Initialize jQuery validation on the dynamically loaded form
                    var form = modal.querySelector('form');
                    if (form && $.validator) {
                        $.validator.unobtrusive.parse(form);
                    }
                },
                error: function (err) {
                    modal.querySelector('.modal-body').innerHTML = '<div class="alert alert-danger">An error occurred while loading the form.</div>';
                }
            });
            bootstrapModal.show();
        }

        function showModalEdit(categoryId) {
            currentMode = 'edit';
            currentCategoryId = categoryId;
            modal.querySelector('.modal-title').textContent = 'Edit Category';
            $.ajax({
                url: '/Categories/Edit/' + categoryId,
                type: 'GET',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    modal.querySelector('.modal-body').innerHTML = response;
                    // Initialize jQuery validation on the dynamically loaded form
                    var form = modal.querySelector('form');
                    if (form && $.validator) {
                        $.validator.unobtrusive.parse(form);
                    }
                },
                error: function (err) {
                    console.log(err);
                    modal.querySelector('.modal-body').innerHTML = '<div class="alert alert-danger">An error occurred while loading the form.</div>';
                }
            });
            bootstrapModal.show();
        }

        function submitModalForm() {
            var modal = document.querySelector('#Modal');
            var form = modal.querySelector('form');
            var $form = $(form);

            // Trigger validation
            if (!$form.valid()) {
                return;
            }

            // Wait for any pending remote validations to complete
            var validator = $form.data('validator');
            if (validator && validator.pendingRequest) {
                // There are pending remote validations, wait for them
                setTimeout(function() {
                    submitModalForm();
                }, 100);
                return;
            }

            // Double check the form is still valid after waiting for remote validators
            if (!$form.valid()) {
                return;
            }

            //disable save button and show loading spinner
            var btn = document.querySelector('#modalSaveButton');
            btn.classList.add('disabled');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...';

            var formData = new FormData(form);
            $.ajax({
                url: form.action,
                type: form.method,
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {

                    btn.classList.remove('disabled');
                    btn.innerHTML = 'Save';

                    if (response.success) {
                        bootstrapModal.hide();

                        var cat = response.category;

                        if (currentMode === 'add') {
                            // Add new row to table
                            var table = document.querySelector('.js-dataTable-full tbody');
                            var newRow = document.createElement('tr');
                            newRow.setAttribute('data-category-id', cat.id);
                            newRow.innerHTML = `
                                <td class="text-center">${cat.id}</td>
                                <td>${cat.name}</td>
                                <td class="category-status">
                                    <span class="fs-xs fw-semibold d-inline-block py-1 px-3 rounded-pill bg-success-light text-success">Available</span>
                                </td>
                                <td>${cat.createdOn}</td>
                                <td class="category-updated">${cat.updatedOn || ''}</td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a href="javascript:;" onclick="showModalEdit(${cat.id})" class="btn btn-sm btn-alt-secondary js-bs-tooltip-enabled" data-bs-toggle="tooltip" aria-label="Edit" data-bs-original-title="Edit">
                                            <i class="fa fa-fw fa-pencil-alt"></i>
                                        </a>
                                        <a href="javascript:;" onclick="toggleStatus(${cat.id})" class="btn btn-sm btn-alt-secondary js-bs-tooltip-enabled" data-bs-toggle="tooltip" aria-label="Delete" data-bs-original-title="Delete">
                                            <i class="fa fa-fw fa-times"></i>
                                        </a>
                                    </div>
                                </td>
                            `;
                            table.insertBefore(newRow, table.firstChild);
                            Swal.fire("Success!", "Category added successfully!", "success");
                            One.helpers('jq-notify', {type: 'success', icon: 'fa fa-check me-1', message: 'Category added!'});
                        } else if (currentMode === 'edit') {
                            // Update existing row
                            var row = document.querySelector('tr[data-category-id="' + currentCategoryId + '"]');
                            if (row) {
                                row.querySelector('td:nth-child(2)').textContent = cat.name;
                                row.querySelector('.category-updated').textContent = cat.updatedOn;
                            }
                            Swal.fire("Success!", "Category updated successfully!", "success");
                            One.helpers('jq-notify', {type: 'success', icon: 'fa fa-check me-1', message: 'Category updated!'});
                        }
                    } else {
                        modal.querySelector('.modal-body').innerHTML = response; // Show validation errors
                        $.validator.unobtrusive.parse(form);
                    }
                },
                error: function (err) {
                    btn.classList.remove('disabled');
                    btn.innerHTML = 'Save';

                    modal.querySelector('.modal-body').innerHTML = '<div class="alert alert-danger">An error occurred while submitting the form.</div>';
                }
            });
        }


    </script>
}
