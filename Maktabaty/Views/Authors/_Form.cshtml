@model AuthorRequest

@{
    ViewData["Title"] = "Add Author";
    var authorId = ViewBag.AuthorId;
}

<form method="POST" asp-action="@(authorId != null ? "Edit" : "Add")" asp-route-id="@authorId" novalidate>
    <input type="hidden" asp-for="Id" value="@authorId">
    <div class="row">
        <div class="col-lg-12 col-xl-12">
            <div class="form-floating mb-4">
                <input type="text" class="form-control" asp-for="Name" placeholder="Name">
                <label asp-for="Name"></label>
                <span asp-validation-for="Name" class="text-danger mt-2 d-block"></span>
            </div>
        </div>
    </div>
</form>
