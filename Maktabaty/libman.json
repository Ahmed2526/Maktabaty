{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/jquery-validation-unobtrusive/",
      "files": [
        "jquery.validate.unobtrusive.min.js"
      ]
    },
    {
      "library": "jquery-ajax-unobtrusive@3.2.6",
      "destination": "wwwroot/jquery-ajax-unobtrusive/"
    },
    {
      "library": "lightbox2@2.11.5",
      "destination": "wwwroot/my-libraries/lightbox2/"
    },
    {
      "provider": "jsdelivr",
      "library": "lightbox3@1.1.0",
      "destination": "wwwroot/lightbox3/",
      "files": [
        "dist/lightbox3.min.css",
        "dist/lightbox3.min.js"
      ]
    }
  ]
}